# still tracked.
/data/
/runs/
/checkpoints/
wandb/
/media/
*.pt
*.pth
*.onnx
*.mlpackage
*.mp4
*.mov

# Campus floor plans and digital twin geometry (not public without the campus's OK)
/private/

# Agent config (CLAUDE.md, skills, hooks): kept local and private
CLAUDE.md
.claude/

# OS junk
.DS_Store

# Paper PDFs (see docs/papers.md) and downloaded Vale style packages
/papers/
.vale/styles/
