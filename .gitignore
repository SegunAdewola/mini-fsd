# pixi environment (rebuilt from pixi.lock)
.pixi/

# colcon workspace outputs
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# MuJoCo writes its warnings here
MUJOCO_LOG.TXT

# Python caches
__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data, renders, checkpoints, media (too big for git; live on Explorer / S3).
# The leading / matches only the repo root, so src/minifsd/data/ (code) is
# still tracked.
/data/
/runs/
/checkpoints/
wandb/
/media/
*.pt
*.pth
*.onnx
*.mlpackage
*.mp4
*.mov

# Campus floor plans and digital twin geometry (not public without the campus's OK)
/private/

# Agent config (CLAUDE.md, skills, hooks): kept local and private
CLAUDE.md
.claude/

# OS junk
.DS_Store

# Paper PDFs (see docs/papers.md) and downloaded Vale style packages
/papers/
.vale/styles/

# Course submissions (kept local): the progress update and its builder, and
# the course's requirement PDFs
/docs/progress-update/
/docs/Final Project*.pdf

# uv run --with (used once to build the progress update PDF) leaves these
uv.lock
.venv/

# The report PDF changes on every build; commit the final one at M6 with
# git add -f docs/report/main.pdf.
/docs/report/main.pdf
